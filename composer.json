{
    "name": "rocket-park/mcp-wrapper",
    "description": "MCP Wrapper is a Craft CMS plugin used to provide MCP manifests for the Craft CMS GraphQL API.",
    "type": "craft-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Rocket Park",
            "homepage": "https://rocketpark.com"
        }
    ],
    "support": {
        "email": "support@rocketpark.com"
    },
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "craftcms/rector": "dev-main",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "rocketpark\\mcpwrapper\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "handle": "mcp-wrapper",
        "name": "MCP Wrapper",
        "developer": "Rocket Park",
        "class": "rocketpark\\mcpwrapper\\McpWrapper",
        "basePath": "src"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
