{# 
MCP Wrapper Analytics Dashboard
Displays performance metrics and usage statistics for the plugin CP section
#}

{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "MCP Analytics" %}
{% set selectedSubnavItem = "analytics" %}
{% set fullPageForm = false %}

{% block content %}
<div id="mcp-analytics-dashboard">
    {# Header Controls #}
    <div class="mcp-controls">
        <div class="mcp-controls-left">
            {{ forms.selectField({
                label: 'Schema',
                id: 'schema-select',
                name: 'schema',
                value: selectedSchema,
                options: schemas|map(s => { label: s, value: s }),
            }) }}

            {{ forms.selectField({
                label: 'Time Range',
                id: 'days-select',
                name: 'days',
                value: days,
                options: [
                    { label: 'Last 24 hours', value: 1 },
                    { label: 'Last 7 days', value: 7 },
                    { label: 'Last 30 days', value: 30 },
                    { label: 'Last 90 days', value: 90 },
                ],
            }) }}
        </div>

        <div class="mcp-controls-right">
            <button type="button" class="btn" id="refresh-btn">
                <span class="spinner hidden" id="refresh-spinner"></span>
                Refresh
            </button>
            {% if canExport is defined and canExport %}
                <a href="{{ actionUrl('mcp-wrapper/analytics/export', { 
                    schemaHandle: selectedSchema, 
                    days: days 
                }) }}" class="btn">Export CSV</a>
            {% endif %}
        </div>
    </div>

    {# Loading State #}
    <div id="loading-state" class="mcp-loading">
        <div class="spinner spinner-big"></div>
        <p>Loading analytics&hellip;</p>
    </div>

    {# Dashboard Content #}
    <div id="dashboard-content" class="hidden">
        {# Summary Cards #}
        <div class="mcp-stat-grid">
            <div class="mcp-stat-card">
                <div class="mcp-stat-label">Total Requests</div>
                <div class="mcp-stat-value" id="stat-total">&ndash;</div>
            </div>
            <div class="mcp-stat-card">
                <div class="mcp-stat-label">Success Rate</div>
                <div class="mcp-stat-value" id="stat-success-rate">&ndash;</div>
            </div>
            <div class="mcp-stat-card">
                <div class="mcp-stat-label">Avg Response Time</div>
                <div class="mcp-stat-value" id="stat-avg-duration">&ndash;</div>
            </div>
            <div class="mcp-stat-card">
                <div class="mcp-stat-label">Cache Hit Rate</div>
                <div class="mcp-stat-value" id="stat-cache-rate">&ndash;</div>
            </div>
        </div>

        {# Top Tools + Response Time #}
        <div class="mcp-two-col">
            <div class="mcp-panel">
                <h2>Top Tools by Usage</h2>
                <div id="top-tools-chart" class="mcp-chart-area"></div>
            </div>

            <div class="mcp-panel">
                <h2>Response Time Distribution</h2>
                <div id="response-time-chart" class="mcp-chart-area"></div>
            </div>
        </div>

        {# Slowest Requests + Errors #}
        <div class="mcp-two-col">
            <div class="mcp-panel">
                <h2>Slowest Requests</h2>
                <table class="data fullwidth">
                    <thead>
                        <tr>
                            <th>Tool</th>
                            <th>Duration</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody id="slowest-requests-table">
                        <tr><td colspan="3" class="zilch">No data</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="mcp-panel">
                <h2>Recent Errors</h2>
                <table class="data fullwidth">
                    <thead>
                        <tr>
                            <th>Tool</th>
                            <th>Error</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody id="errors-table">
                        <tr><td colspan="3" class="zilch">No errors</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* ── Controls bar ─────────────────────────────────── */
    .mcp-controls {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 24px;
    }
    .mcp-controls-left {
        display: flex;
        gap: 16px;
        align-items: flex-end;
    }
    .mcp-controls-left .field {
        margin-bottom: 0;
    }
    .mcp-controls-right {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    /* ── Loading ──────────────────────────────────────── */
    .mcp-loading {
        text-align: center;
        padding: 48px 0;
    }
    .mcp-loading p {
        margin-top: 16px;
        color: var(--gray-500);
    }

    /* ── Stat cards ───────────────────────────────────── */
    .mcp-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    @media (max-width: 900px) {
        .mcp-stat-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    .mcp-stat-card {
        background: var(--white);
        border: 1px solid var(--hairline-color);
        border-radius: var(--large-border-radius, 8px);
        padding: 20px 24px;
    }
    .mcp-stat-label {
        font-size: 13px;
        color: var(--gray-500);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }
    .mcp-stat-value {
        font-size: 28px;
        font-weight: 600;
        color: var(--text-color);
        line-height: 1.2;
    }

    /* ── Two-column layout ────────────────────────────── */
    .mcp-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 24px;
    }
    @media (max-width: 900px) {
        .mcp-two-col {
            grid-template-columns: 1fr;
        }
    }

    /* ── Panel (card) ─────────────────────────────────── */
    .mcp-panel {
        background: var(--white);
        border: 1px solid var(--hairline-color);
        border-radius: var(--large-border-radius, 8px);
        padding: 24px;
    }
    .mcp-panel h2 {
        font-size: 15px;
        font-weight: 600;
        margin: 0 0 16px;
        color: var(--text-color);
    }

    /* ── Chart area ───────────────────────────────────── */
    .mcp-chart-area {
        min-height: 200px;
    }

    /* ── Tool row inside top-tools chart ──────────────── */
    .mcp-tool-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--hairline-color);
    }
    .mcp-tool-row:last-child {
        border-bottom: none;
    }
    .mcp-tool-name {
        font-weight: 500;
        color: var(--text-color);
        word-break: break-all;
    }
    .mcp-tool-meta {
        display: flex;
        gap: 16px;
        flex-shrink: 0;
        margin-left: 12px;
    }
    .mcp-tool-meta span {
        font-size: 13px;
        color: var(--gray-500);
        white-space: nowrap;
    }

    /* ── Badge helpers ────────────────────────────────── */
    .mcp-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
    }
    .mcp-badge--warning {
        background: var(--yellow-050, #fef3c7);
        color: var(--yellow-800, #92400e);
    }
    .mcp-badge--danger {
        background: var(--red-050, #fef2f2);
        color: var(--red-600, #dc2626);
    }

    /* ── Misc ─────────────────────────────────────────── */
    .zilch {
        text-align: center;
        color: var(--gray-500);
        padding: 16px 0;
    }
</style>

<script>
(function() {
    const schemaSelect = document.getElementById('schema-select');
    const daysSelect = document.getElementById('days-select');
    const refreshBtn = document.getElementById('refresh-btn');
    const loadingState = document.getElementById('loading-state');
    const dashboardContent = document.getElementById('dashboard-content');

    // Escape HTML to prevent XSS from untrusted log data
    function esc(str) {
        const el = document.createElement('span');
        el.textContent = str;
        return el.innerHTML;
    }

    async function loadAnalytics() {
        const schema = schemaSelect?.value || '{{ selectedSchema }}';
        const days = daysSelect?.value || {{ days }};

        loadingState.classList.remove('hidden');
        dashboardContent.classList.add('hidden');

        try {
            const response = await fetch(
                `{{ actionUrl('mcp-wrapper/analytics/data') }}?schemaHandle=${encodeURIComponent(schema)}&days=${encodeURIComponent(days)}`,
                {
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-Token': '{{ craft.app.request.csrfToken }}'
                    }
                }
            );

            const result = await response.json();
            if (result.success) {
                renderDashboard(result.data);
            } else {
                Craft.cp.displayError('Failed to load analytics');
            }
        } catch (error) {
            console.error('Analytics error:', error);
            Craft.cp.displayError('Failed to load analytics');
        } finally {
            loadingState.classList.add('hidden');
            dashboardContent.classList.remove('hidden');
        }
    }

    function renderDashboard(data) {
        document.getElementById('stat-total').textContent =
            (data.total_requests || 0).toLocaleString();
        document.getElementById('stat-success-rate').textContent =
            (data.success_rate || 0).toFixed(1) + '%';
        document.getElementById('stat-avg-duration').textContent =
            (data.avg_duration_ms || 0).toFixed(0) + 'ms';
        document.getElementById('stat-cache-rate').textContent =
            (data.cache_hit_rate || 0).toFixed(1) + '%';

        renderTopTools(data.top_tools || []);
        renderResponseTimeDistribution(data);
        renderSlowestRequests(data.slowest_requests || []);
        renderErrors(data.recent_errors || []);
    }

    function renderTopTools(tools) {
        const el = document.getElementById('top-tools-chart');
        if (!tools.length) {
            el.innerHTML = '<p class="zilch">No data available</p>';
            return;
        }
        el.innerHTML = tools.slice(0, 10).map(function(t) {
            return '<div class="mcp-tool-row">'
                + '<span class="mcp-tool-name">' + esc(t.tool) + '</span>'
                + '<span class="mcp-tool-meta">'
                + '<span>' + Number(t.count).toLocaleString() + ' calls</span>'
                + '<span>' + Number(t.avg_duration_ms).toFixed(0) + 'ms avg</span>'
                + '</span></div>';
        }).join('');
    }

    function renderResponseTimeDistribution(data) {
        const el = document.getElementById('response-time-chart');
        if (!data.top_tools || !data.top_tools.length) {
            el.innerHTML = '<p class="zilch">No data available</p>';
            return;
        }
        // Simple text-based distribution from available data
        const buckets = { '<100ms': 0, '100-500ms': 0, '500ms-1s': 0, '>1s': 0 };
        (data.slowest_requests || []).forEach(function(r) {
            var d = r.duration_ms || 0;
            if (d < 100) { buckets['<100ms']++; }
            else if (d < 500) { buckets['100-500ms']++; }
            else if (d < 1000) { buckets['500ms-1s']++; }
            else { buckets['>1s']++; }
        });
        var html = '';
        for (var key in buckets) {
            html += '<div class="mcp-tool-row">'
                + '<span class="mcp-tool-name">' + esc(key) + '</span>'
                + '<span class="mcp-tool-meta"><span>' + buckets[key] + ' requests</span></span>'
                + '</div>';
        }
        el.innerHTML = html;
    }

    function renderSlowestRequests(requests) {
        const tbody = document.getElementById('slowest-requests-table');
        if (!requests.length) {
            tbody.innerHTML = '<tr><td colspan="3" class="zilch">No data</td></tr>';
            return;
        }
        tbody.innerHTML = requests.slice(0, 10).map(function(req) {
            var cls = (req.duration_ms > 1000) ? 'mcp-badge--danger' : 'mcp-badge--warning';
            return '<tr>'
                + '<td><code>' + esc(req.tool) + '</code></td>'
                + '<td><span class="mcp-badge ' + cls + '">' + Number(req.duration_ms).toFixed(0) + 'ms</span></td>'
                + '<td style="color:var(--gray-500); font-size:13px;">' + esc(new Date(req.timestamp).toLocaleString()) + '</td>'
                + '</tr>';
        }).join('');
    }

    function renderErrors(errors) {
        const tbody = document.getElementById('errors-table');
        if (!errors.length) {
            tbody.innerHTML = '<tr><td colspan="3" class="zilch">No errors</td></tr>';
            return;
        }
        tbody.innerHTML = errors.slice(0, 10).map(function(err) {
            return '<tr>'
                + '<td><code>' + esc(err.tool || 'unknown') + '</code></td>'
                + '<td style="font-size:13px;">' + esc(err.error_message || 'Unknown error') + '</td>'
                + '<td style="color:var(--gray-500); font-size:13px;">' + esc(new Date(err.timestamp).toLocaleString()) + '</td>'
                + '</tr>';
        }).join('');
    }

    schemaSelect?.addEventListener('change', loadAnalytics);
    daysSelect?.addEventListener('change', loadAnalytics);
    refreshBtn?.addEventListener('click', loadAnalytics);

    loadAnalytics();
})();
</script>
{% endblock %}
