<div id="mcp-manifest-app" class="mcp-manifest-manager">
  <h1 class="mb-4">MCP Manifest Manager</h1>

  <table class="data fullwidth">
    <thead>
      <tr>
        <th>Schema Handle</th>
        <th>Status</th>
        <th>Last Generated</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for schema in schemas %}
      <tr data-schema="{{ schema.handle }}">
        <td><code>{{ schema.handle }}</code></td>
        <td class="status-cell">
          {% if schema.exists %}
            <span class="status-cached">✅ Cached</span>
          {% else %}
            <span class="status-notbuilt">⚠️ Not built</span>
          {% endif %}
          <span class="status-rebuilding" style="display:none">⏳ rebuilding…</span>
        </td>
        <td class="lastmodified-cell">{{ schema.lastModified ?? '—' }}</td>
        <td>
          {% if schema.exists %}
            <a href="{{ schema.urlView }}" target="_blank" class="btn small">View JSON</a>
          {% endif %}
          <button class="btn small rebuild-btn" data-url="{{ schema.urlRebuild }}" data-handle="{{ schema.handle }}">Rebuild</button>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<script>
document.querySelectorAll('.rebuild-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const handle = this.dataset.handle;
    const url = this.dataset.url;
    const row = document.querySelector(`tr[data-schema="${handle}"]`);
    const statusCell = row.querySelector('.status-cell');
    const lastModifiedCell = row.querySelector('.lastmodified-cell');
    
    // Show rebuilding status
    statusCell.querySelectorAll('span').forEach(s => s.style.display = 'none');
    statusCell.querySelector('.status-rebuilding').style.display = 'inline';
    this.disabled = true;
    
    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: { 'X-CSRF-Token': Craft.csrfTokenValue }
      });
      
      if (!response.ok) throw new Error('HTTP ' + response.status);
      
      const data = await response.json();
      
      // Update status
      statusCell.querySelectorAll('span').forEach(s => s.style.display = 'none');
      statusCell.querySelector('.status-cached').style.display = 'inline';
      lastModifiedCell.textContent = data.lastModified;
      
      Craft.cp.displayNotice(`Rebuilt manifest for "${handle}".`);
    } catch (err) {
      statusCell.querySelectorAll('span').forEach(s => s.style.display = 'none');
      statusCell.querySelector('.status-cached, .status-notbuilt').forEach(s => s.style.display = 'inline');
      Craft.cp.displayError(`Failed to rebuild ${handle}: ${err.message}`);
    } finally {
      this.disabled = false;
    }
  });
});
</script>