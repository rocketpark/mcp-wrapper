# MCP Wrapper - Environment Variables
# Copy this file to .env and fill in your values.

# ===========================================
# Required: Craft CMS GraphQL Schema Token
# ===========================================
# Get this from Craft CP: Settings > GraphQL > Schemas > [Your Schema] > Access Token
MCP_GQLSCHEMA_TOKEN=

# ===========================================
# Required: Primary Site URL
# ===========================================
# The base URL for your Craft CMS site (used for generating absolute URLs)
PRIMARY_SITE_URL=https://your-site.com

# ===========================================
# Optional: Botpress Integration
# ===========================================
# Required only if using the KB sync console command (php craft mcp-wrapper/sync-kb)
BOTPRESS_PAT=
BOTPRESS_BOT_ID=

# ===========================================
# Optional: Webhook Security
# ===========================================
# Secret key for HMAC SHA-256 webhook signatures
MCP_WEBHOOK_SECRET=
